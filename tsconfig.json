{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      // `@/` points at src/. The template also aliased `@/assets/*` to the
      // repo-root assets/ folder (app icon, splash), but those are referenced
      // by relative path from app.json and never imported, so the extra alias
      // only got in the way of `@/assets/manifest`.
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
