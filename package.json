{
  "name": "zgame",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zgame: a co-op multiplayer space strategy game",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite client",
    "build": "vite build client",
    "start": "npm run build && tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "balance": "tsx server/balance-sim.ts",
    "balance:new": "tsx server/balance-new.ts",
    "bench": "tsx server/bench.ts",
    "demo": "tsx server/seed-demo.ts && cross-env ZGAME_SAVE=data/demo-world.json tsx server/index.ts",
    "backup": "tsx server/backup.ts",
    "e2e": "npm run build && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "playwright-core": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
